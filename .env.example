PII_DB_NAME=pii_protect
PII_DB_USER=pii_protect
# Required by docker-compose.prod.yml (no fallback; compose aborts if unset):
# PII_DB_PASSWORD, PII_ENCRYPTION_KEY, PII_ADMIN_INITIAL_KEY, PII_CORS_ALLOWED_ORIGINS
PII_DB_PASSWORD=CHANGE_ME
PII_DB_PORT=15433
PII_API_PORT=15500
PII_UI_PORT=15501
PII_ENCRYPTION_KEY=CHANGE_ME_generate_with_Fernet.generate_key()
PII_ADMIN_INITIAL_KEY=CHANGE_ME_initial_admin_key
# Production only, comma-separated, e.g. https://admin.example.com
PII_CORS_ALLOWED_ORIGINS=
PII_FAILURE_MODE=closed
PII_BATCH_MAX_ITEMS=50
PII_ENGINE_EXPOSURE=self_hosted
PII_MULTITENANCY_ENABLED=false
PII_ACCEPT_TENANT_HEADER=false
PII_GRPC_ENABLED=false
PII_GRPC_HOST=0.0.0.0
PII_GRPC_PORT=50051
PII_MODEL_CACHE_DIR=/root/.cache/huggingface
PII_DATA_RESIDENCY_REGION=unspecified
PII_REQUIRE_DATA_RESIDENCY=false

# Optional marketplace client. Leave MARKETPLACE_URL empty for a fully local core.
PLUGIN_DIR=./plugins
PII_IMAGE_MAX_BYTES=4000000
PII_IMAGE_MAX_PIXELS=25000000
PII_DOCUMENT_MAX_BYTES=4000000
PII_DOCUMENT_MAX_PAGES=10
# Zero-retention document service (/v1/documents/*): upload limit, PDF page
# limit, processing timeout and PDF rasterization DPI (higher = sharper, larger).
PII_DOCUMENT_UPLOAD_MAX_BYTES=20000000
PII_DOCUMENT_UPLOAD_MAX_PAGES=200
PII_DOCUMENT_TIMEOUT_SECONDS=60
PII_DOCUMENT_PDF_DPI=200
# Memory-bounded document processing (defaults shown):
# PDF pages render at PDF_DPI, lowered per page to stay under MAX_PAGE_PIXELS; a page
# needing less than MIN_DPI is rejected (422 PDF_PAGE_TOO_LARGE). Redacted PDFs stream page by page.
PII_DOCUMENT_PDF_MAX_PAGE_PIXELS=16000000
PII_DOCUMENT_PDF_MIN_DPI=50
# Extracted-text cap and overlapping detection windows (bounded model input per call).
# Over the cap -> immediate 422 DOCUMENT_TOO_LONG (estimated_max_pages = cap // 2200). Keep
# cap / detection chars-per-second under PII_DOCUMENT_TIMEOUT_SECONDS (prod: 90000 at ~1.1k/s).
PII_DOCUMENT_MAX_TEXT_CHARS=500000
PII_DOCUMENT_DETECTION_WINDOW_CHARS=6000
PII_DOCUMENT_DETECTION_WINDOW_OVERLAP=300
# Admission per worker process: concurrent document jobs, wait for a slot before
# 503 ENGINE_BUSY (+Retry-After), optional RSS ceiling in MB (0 = off). Text endpoints unaffected.
# The engine runs one uvicorn worker, so this is per container. Each job peaks at ~0.3-0.5 GB;
# default 2 is safe anywhere, 4 is recommended on the prod host (12 CPU, 47 GB RAM, no swap).
PII_DOCUMENT_MAX_CONCURRENT_JOBS=2
PII_DOCUMENT_BUSY_TIMEOUT_SECONDS=2
PII_DOCUMENT_MAX_RSS_MB=0
# DOCX zip inspection before parsing (422 DOCX_*): parts, total inflated bytes, per-part ratio.
PII_DOCUMENT_DOCX_MAX_ENTRIES=1000
PII_DOCUMENT_DOCX_MAX_UNCOMPRESSED_BYTES=100000000
PII_DOCUMENT_DOCX_MAX_RATIO=100
PLUGIN_AUTOLOAD=false
MARKETPLACE_URL=
MARKETPLACE_TOKEN=
MARKETPLACE_PUBLIC_KEY=
MARKETPLACE_TIMEOUT_SECONDS=10
MARKETPLACE_MAX_PACKAGE_BYTES=50000000

# Optional asynchronous anonymization worker
ASYNC_JOB_WORKER_API_URL=http://api:8000
ASYNC_JOB_POLL_SECONDS=1
ASYNC_JOB_MAX_ATTEMPTS=3
ASYNC_JOB_WEBHOOK_HOSTS=

# Detection layers — set enabled=false to disable a layer
# Format: JSON object
PII_DETECTION_LAYERS={"regex":{"enabled":true,"priority":10},"presidio":{"enabled":true,"priority":20},"privacy_filter":{"enabled":true,"priority":30}}
