# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pii:pii@localhost:5432/pii

# ── Security ──────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=changeme-32-chars-minimum-secret!
ADMIN_INITIAL_KEY=changeme-admin-key

# ── Engine mode ───────────────────────────────────────────────────────────────
PII_ENGINE_EXPOSURE=self_hosted       # self_hosted | internal
MULTITENANCY_ENABLED=false            # true only in cloud shared-engine deployment
PII_ACCEPT_TENANT_HEADER=false        # true only when called from pii-cloud/gateway
PII_INTERNAL_API_KEY=                 # set in cloud deployments, empty in self-hosted
PII_DEFAULT_TENANT_ID=                # leave empty; used only internally

# ── Asynchronous anonymization jobs (optional) ───────────────────────────────
# Start the worker with: docker compose --profile async-jobs up -d worker
ASYNC_JOB_WORKER_API_URL=http://api:8000
ASYNC_JOB_POLL_SECONDS=1
ASYNC_JOB_MAX_ATTEMPTS=3
ASYNC_JOB_WEBHOOK_HOSTS=            # comma-separated HTTPS hostnames; empty disables callbacks

# ── Behaviour ─────────────────────────────────────────────────────────────────
FAILURE_MODE=closed
BATCH_MAX_ITEMS=50
MAPPING_TTL_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
PII_CORS_ALLOWED_ORIGINS=

# ── ML models ─────────────────────────────────────────────────────────────────
SPACY_MODEL=it_core_news_lg
PRIVACY_FILTER_MODEL=openai/privacy-filter
AI4PRIVACY_MODEL=Isotonic/distilbert_finetuned_ai4privacy_v2

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=
APP_ENV=development
